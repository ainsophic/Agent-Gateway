# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
E2B_API_KEY=e2b_...

# ── Storage ───────────────────────────────────────────────────────────────────
GATEWAY_DB_PATH=./data/results.db

# ── Context Optimizer ─────────────────────────────────────────────────────────
GATEWAY_MAX_OUTPUT_BYTES=8192
GATEWAY_MAX_OUTPUT_LINES=100
GATEWAY_RESULT_TTL_SECONDS=3600
GATEWAY_FRAGMENT_MAX_LIMIT=100

# ── Loop Arbiter ──────────────────────────────────────────────────────────────
GATEWAY_MAX_TOTAL_CALLS=50
GATEWAY_MAX_REPEAT_CALLS=3
GATEWAY_RATE_WINDOW_SECONDS=5.0
GATEWAY_RATE_MAX_CALLS=10
GATEWAY_OSCILLATION_MIN_CYCLE=2
GATEWAY_OSCILLATION_CYCLES=3

# ── Secure Executor ───────────────────────────────────────────────────────────
GATEWAY_SANDBOX_TIMEOUT_SECONDS=30
GATEWAY_MAX_SANDBOX_AGE_SECONDS=1800
GATEWAY_MAX_FILE_BYTES=10485760
GATEWAY_EXEC_MAX_OUTPUT_BYTES=65536

# ── MCP Transport (stdio | sse) ───────────────────────────────────────────────
MCP_TRANSPORT=stdio
MCP_SSE_HOST=127.0.0.1
MCP_SSE_PORT=8000
